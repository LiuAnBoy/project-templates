# Docker only. Where the web container reaches the API: the build argument and
# the runtime value of the web image. The default works where Docker forwards
# host.docker.internal to the host (Docker Desktop). On Linux that name is the
# bridge address, and a server published on 127.0.0.1 does not listen there: put
# the web and the server on one external network and name the server's service
# (http://<service>:8000), or use the host's real address.
DOCKER_API_HOST=http://host.docker.internal:8000
# Loopback port that reaches the web container.
WEB_PORT=3000
