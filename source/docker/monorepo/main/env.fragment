# Names this project's containers, networks and volumes. It is filled with the
# project's name; change it to a value that is unique on this machine (lower case
# letters, digits, - and _), so two projects never share a container or a volume
# and `down -v` cannot reach another project's data.
COMPOSE_PROJECT_NAME=__COMPOSE_NAME__
# The subnet of the `edge` network, which holds the web part(s) and the server and
# nothing else. It is derived from the project's name; change it when
# `docker compose up` reports "Pool overlaps".
EDGE_SUBNET=__EDGE_SUBNET__
# The proxies the server believes: the web parts forward the visitor's address, and
# only a peer on `edge` is believed, so a container elsewhere cannot choose its own
# rate-limit bucket. Keep it equal to EDGE_SUBNET.
TRUST_PROXY=__EDGE_SUBNET__
# Loopback port that reaches the web part. Opening it beyond loopback needs a
# reverse proxy in front.
WEB_PORT=3000
