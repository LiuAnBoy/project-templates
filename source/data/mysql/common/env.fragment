# MySQL. A server run on the host reads DATABASE_URL; in containers compose builds
# the URL itself from the MYSQL_* values and the service name, and the service
# creates MYSQL_DATABASE and the user MYSQL_USER. MYSQL_PASSWORD must be URL-safe
# (letters, digits, - . _ ~), because compose cannot encode it.
DATABASE_URL=mysql://app:dev-only-mysql-pw-9f3a@localhost:3306/app
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=dev-only-mysql-pw-9f3a
# Read by the project's own MySQL service alone, to create the database and the
# user. The application never connects as root; compose blanks it in server and migrate.
MYSQL_ROOT_PASSWORD=dev-only-mysql-root-pw-4c1d
MYSQL_PORT=3306
# Read only by the integration tests, which refuse a non-local host.
TEST_DATABASE_URL=mysql://app:dev-only-mysql-pw-9f3a@localhost:3306/app
