# PostgreSQL. A server run on the host reads DATABASE_URL; in containers compose
# builds the URL itself from the POSTGRES_* values and the service name, and
# creates the database named by POSTGRES_DATABASE. POSTGRES_PASSWORD must be
# URL-safe (letters, digits, - . _ ~), because compose cannot encode it.
DATABASE_URL=postgresql://app:dev-only-postgres-pw-9f3a@localhost:5432/app
POSTGRES_DATABASE=app
POSTGRES_USER=app
POSTGRES_PASSWORD=dev-only-postgres-pw-9f3a
POSTGRES_PORT=5432
# Read only by the integration tests, which refuse a non-local host.
TEST_DATABASE_URL=postgresql://app:dev-only-postgres-pw-9f3a@localhost:5432/app
# The compose files docker compose reads. To use a PostgreSQL server that
# already runs on a docker network, change four lines in .env and nothing else:
# this line to docker-compose.yml:docker-compose.postgres-cluster.yml, the
# network line below, DATABASE_URL to that server's URL, and POSTGRES_DATABASE
# to the plain name of a database that exists there. Keep POSTGRES_PASSWORD set.
COMPOSE_FILE=docker-compose.yml
# The docker network the existing PostgreSQL server is on; read only when
# COMPOSE_FILE names the cluster file.
POSTGRES_DOCKER_NETWORK=
