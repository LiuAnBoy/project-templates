# Fake values for local development. Copy to .env to override the defaults.
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Rate limit per client: 300 requests per 60 seconds unless changed here.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# Leave empty unless the server runs behind a reverse proxy: a comma-separated
# list of the proxy addresses or ranges (10.0.0.1,172.16.0.0/12).
TRUST_PROXY=

# Names this project's containers, networks and volumes. Give it a value that
# is unique on this machine (lower case letters, digits, - and _): docker
# compose refuses to start while it is empty, so two projects never share a
# container or a volume and `down -v` cannot reach another project's data.
COMPOSE_PROJECT_NAME=

# SQLite. DATABASE_URL is the path of the database file, relative to the
# directory the server starts in. Only the migration command creates the file; a
# wrong path stops the boot instead of starting an empty database.
DATABASE_URL=./data/app.db

# Redis. A server run on the host reads REDIS_URL; in containers compose gives
# the server redis://redis:6379, the service of docker-compose.yml, whatever
# REDIS_URL says. REDIS_PORT is the loopback port of that service.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Read only by the integration tests, which refuse a non-local host.
TEST_REDIS_URL=redis://localhost:6379
