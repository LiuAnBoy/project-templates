{
  "name": "nest",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env scripts/db/status.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.21",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
