# Fake values for local development. Copy to .env to override the defaults.
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Rate limit per client: 300 requests per 60 seconds unless changed here.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# Leave empty unless the server runs behind a reverse proxy: a comma-separated
# list of the proxy addresses or ranges (10.0.0.1,172.16.0.0/12).
TRUST_PROXY=

# Names this project's containers, networks and volumes. Give it a value that
# is unique on this machine (lower case letters, digits, - and _): docker
# compose refuses to start while it is empty, so two projects never share a
# container or a volume and `down -v` cannot reach another project's data.
COMPOSE_PROJECT_NAME=

# MySQL. A server run on the host reads DATABASE_URL; in containers compose builds
# the URL itself from the MYSQL_* values and the service name, and the service
# creates MYSQL_DATABASE and the user MYSQL_USER. MYSQL_PASSWORD must be URL-safe
# (letters, digits, - . _ ~), because compose cannot encode it.
DATABASE_URL=mysql://app:dev-only-mysql-pw-9f3a@localhost:3306/app
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=dev-only-mysql-pw-9f3a
# Read by the project's own MySQL service alone, to create the database and the
# user. The application never connects as root; compose blanks it in server and migrate.
MYSQL_ROOT_PASSWORD=dev-only-mysql-root-pw-4c1d
MYSQL_PORT=3306
# Read only by the integration tests, which refuse a non-local host.
TEST_DATABASE_URL=mysql://app:dev-only-mysql-pw-9f3a@localhost:3306/app
