# Fake values for local development. Copy to .env to override the defaults.
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Rate limit per client: 300 requests per 60 seconds unless changed here.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# Leave empty unless the server runs behind a reverse proxy: a comma-separated
# list of the proxy addresses or ranges (10.0.0.1,172.16.0.0/12).
TRUST_PROXY=

# PostgreSQL. The server reads DATABASE_URL only; the other values serve
# docker-compose.dev.yml. On a shared server, change these values in .env and
# nothing else: POSTGRES_DATABASE must name a database that exists there.
DATABASE_URL=postgresql://app:dev-only-postgres-pw-9f3a@localhost:5432/app
POSTGRES_DATABASE=app
POSTGRES_USER=app
POSTGRES_PASSWORD=dev-only-postgres-pw-9f3a
POSTGRES_PORT=5432
# Read only by `pnpm test:integration`, which refuses a non-local host.
TEST_DATABASE_URL=postgresql://app:dev-only-postgres-pw-9f3a@localhost:5432/app
