{
  "name": "fastify",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env scripts/db/status.mjs",
    "db:pull": "node --env-file-if-exists=.env scripts/db/pull.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
