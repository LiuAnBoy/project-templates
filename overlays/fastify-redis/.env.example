# Fake values for local development. Copy to .env to override the defaults.
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Rate limit per client: 300 requests per 60 seconds unless changed here.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# Leave empty unless the server runs behind a reverse proxy: a comma-separated
# list of the proxy addresses or ranges (10.0.0.1,172.16.0.0/12).
TRUST_PROXY=

# Redis. The server reads REDIS_URL only; REDIS_PORT serves
# docker-compose.dev.yml. On a shared server, change these values in .env and
# nothing else.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Read only by `pnpm test:integration`, which refuses a non-local host.
TEST_REDIS_URL=redis://localhost:6379
